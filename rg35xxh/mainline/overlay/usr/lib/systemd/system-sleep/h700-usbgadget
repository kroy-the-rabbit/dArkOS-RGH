# From ROCKNIX quirks/platforms/H700/sleep.d/post/005-usbgadget, as a systemd sleep hook.

# musb drops the USB session on suspend and does not restart it on resume
case "$1" in
post)
	# own unit: systemd-suspend.service kills leftover children
	systemd-run --no-block --collect --quiet --unit=h700-usbgadget "$0" rebind
	exit 0 ;;
rebind) ;;
*) exit 0 ;;
esac
UDC=$(ls /sys/class/udc 2>/dev/null | head -n1)
GADGET=$(ls -d /sys/kernel/config/usb_gadget/*/ 2>/dev/null | head -n1)
[ -n "${UDC}" ] && [ -n "${GADGET}" ] || exit 0
[ "$(cat "${GADGET}/UDC" 2>/dev/null)" = "${UDC}" ] || exit 0

sleep 3
[ "$(cat "/sys/class/udc/${UDC}/state")" = "not attached" ] || exit 0
echo "" > "${GADGET}/UDC"
sleep 1
echo "${UDC}" > "${GADGET}/UDC"
